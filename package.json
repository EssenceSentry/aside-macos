{
  "name": "aside",
  "private": true,
  "version": "0.0.0",
  "description": "A personal meeting companion that listens, remembers, and prepares useful context.",
  "type": "module",
  "workspaces": [
    "theme"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome check",
    "fix": "biome check --write",
    "check": "node scripts/check.mjs",
    "prepare": "lefthook install",
    "macos:build": "bash scripts/build-macos.sh",
    "macos": "bash scripts/run-macos.sh",
    "test:native": "bash scripts/test-native.sh",
    "test:ui": "npm run build && node scripts/smoke-ui.mjs"
  },
  "dependencies": {
    "@atelier/theme": "*",
    "@base-ui/react": "^1.9.0",
    "@observablehq/plot": "^0.6.17",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "lefthook": "2.2.1",
    "playwright": "1.63.0",
    "shadcn": "^4.23.0",
    "typescript": "~6.0.2",
    "vite": "^8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
